{
  "expo": {
    "name": "Market Pulse",
    "slug": "market-pulse",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "marketpulse",
    "userInterfaceStyle": "dark",
    "ios": {},
    "android": {
      "package": "com.sasamx22.marketpulse",
      "predictiveBackGestureEnabled": false,
      "versionCode": 2
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
